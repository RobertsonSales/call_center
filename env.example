# Copie este arquivo para ".env" (não versionado) para testar localmente
# com "vercel dev". Em produção, configure estas mesmas variáveis
# em Vercel → Project Settings → Environment Variables.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA-ANON-KEY-AQUI

# Poderes administrativos totais (ignora RLS) — usada só por
# api/agentes.js, no servidor. NUNCA exponha esta chave no navegador
# nem a comite num repositório público.
SUPABASE_SERVICE_ROLE_KEY=SUA-SERVICE-ROLE-KEY-AQUI
